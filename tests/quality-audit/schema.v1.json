{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf-creator.local/quality-audit/schema.v1.json",
  "title": "PDF quality audit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureVersion", "title", "profiles", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtureVersion": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profile" },
      "required": ["pr-a-local", "pr-a-preview"],
      "properties": {
        "pr-a-local": { "$ref": "#/$defs/profile" },
        "pr-a-preview": { "$ref": "#/$defs/profile" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "expectedClass": {
      "enum": [
        "supported-and-expected-to-pass",
        "intentionally-rejected-by-documented-policy",
        "unsupported-feature",
        "known-service-defect",
        "environmental-limitation",
        "audit-fixture-or-tool-limitation"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "orientation", "marginsInches"],
      "properties": {
        "format": { "enum": ["Letter", "A4", "Legal"] },
        "orientation": { "enum": ["portrait", "landscape"] },
        "marginsInches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number", "minimum": 0, "maximum": 2 },
            "right": { "type": "number", "minimum": 0, "maximum": 2 },
            "bottom": { "type": "number", "minimum": 0, "maximum": 2 },
            "left": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "author", "subject", "keywords"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(tests|audit)/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mutation": {
          "enum": ["script", "external-url", "local-file-url", "mixed-orientation-css"]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "storeResult", "storeHtml", "page", "metadata", "correlationId"],
      "properties": {
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.pdf$" },
        "storeResult": { "const": false },
        "storeHtml": { "const": false },
        "page": { "$ref": "#/$defs/page" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "pageRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1, "maximum": 25 },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 25 }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPoints", "heightPoints"],
      "properties": {
        "widthPoints": { "type": "number", "minimum": 1 },
        "heightPoints": { "type": "number", "minimum": 1 }
      }
    },
    "geometricExpectations": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "allPagesNonblank": { "type": "boolean" },
        "requiredTextOrder": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "repeatTextOnEveryPage": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "perPageRequiredText": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pageNumber", "text"],
            "properties": {
              "pageNumber": { "type": "integer", "minimum": 1, "maximum": 25 },
              "text": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "informationalNotes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseKind", "httpStatus", "requiredText", "forbiddenText"],
      "properties": {
        "responseKind": { "enum": ["pdf", "error", "unsupported-observation"] },
        "httpStatus": {
          "oneOf": [
            { "type": "integer", "minimum": 100, "maximum": 599 },
            { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 599 } }
          ]
        },
        "serviceErrorCode": { "type": "string", "minLength": 1 },
        "contentType": { "type": "string", "minLength": 1 },
        "pageCount": { "$ref": "#/$defs/pageRange" },
        "pageDimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "requiredText": { "type": "array", "items": { "type": "string" } },
        "forbiddenText": { "type": "array", "items": { "type": "string" } },
        "metadata": { "$ref": "#/$defs/metadata" },
        "visualReferenceId": { "type": "string", "minLength": 1 },
        "geometricExpectations": { "$ref": "#/$defs/geometricExpectations" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["repeat", "alternating-isolation"] },
        "sourceCaseId": { "type": "string" },
        "sourceCaseIds": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "repetitions": { "type": "integer", "minimum": 2, "maximum": 10 },
        "sequence": { "type": "array", "minItems": 2, "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "repeat" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "sourceCaseId": true,
              "repetitions": true
            },
            "required": ["sourceCaseId", "repetitions"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "alternating-isolation" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "sourceCaseIds": true,
              "sequence": true
            },
            "required": ["sourceCaseIds", "sequence"]
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "capabilityIds", "expectedClass", "previewEligible"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["supported-basic-pdf", "intentional-policy-rejection", "unsupported-capability", "isolation", "repeatability"]
        },
        "capabilityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "expectedClass": { "$ref": "#/$defs/expectedClass" },
        "source": { "$ref": "#/$defs/source" },
        "request": { "$ref": "#/$defs/request" },
        "expected": { "$ref": "#/$defs/expected" },
        "scenario": { "$ref": "#/$defs/scenario" },
        "previewEligible": { "type": "boolean" },
        "evidenceRequirements": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["structure", "page-geometry", "text", "metadata", "visual-reference", "policy-response", "isolation", "repeatability"] }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "scenario": true },
            "required": ["scenario"]
          },
          "then": {},
          "else": {
            "properties": {
              "source": true,
              "request": true,
              "expected": true,
              "evidenceRequirements": true
            },
            "required": ["source", "request", "expected", "evidenceRequirements"]
          }
        },
        {
          "if": {
            "properties": { "category": { "const": "supported-basic-pdf" } },
            "required": ["category"]
          },
          "then": {
            "properties": {
              "expectedClass": {
                "enum": [
                  "supported-and-expected-to-pass",
                  "known-service-defect",
                  "environmental-limitation",
                  "audit-fixture-or-tool-limitation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "category": { "const": "intentional-policy-rejection" } },
            "required": ["category"]
          },
          "then": {
            "properties": { "expectedClass": { "const": "intentionally-rejected-by-documented-policy" } }
          }
        },
        {
          "if": {
            "properties": { "category": { "const": "unsupported-capability" } },
            "required": ["category"]
          },
          "then": {
            "properties": { "expectedClass": { "const": "unsupported-feature" } }
          }
        },
        {
          "if": {
            "properties": { "category": { "enum": ["isolation", "repeatability"] } },
            "required": ["category"]
          },
          "then": {
            "properties": {
              "expectedClass": {
                "enum": [
                  "supported-and-expected-to-pass",
                  "known-service-defect",
                  "environmental-limitation",
                  "audit-fixture-or-tool-limitation"
                ]
              }
            }
          }
        }
      ]
    },
    "profileGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseIds", "repetitions"],
      "properties": {
        "caseIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "maximumConcurrency", "maximumGetRequests", "maximumPostRequests", "groups"],
      "properties": {
        "lane": { "enum": ["local", "preview"] },
        "maximumConcurrency": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maximumGetRequests": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maximumPostRequests": { "type": "integer", "minimum": 0, "maximum": 100 },
        "startSpacingMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profileGroup" } }
      }
    },
    "result": {
      "$id": "https://pdf-creator.local/quality-audit/result.v1.json",
      "type": "object",
      "additionalProperties": true,
      "$defs": {
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator", "value", "percentage"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 0 },
            "denominator": { "type": "integer", "minimum": 0 },
            "value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "percentage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
          }
        },
        "categoryMetrics": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "uniqueFixturesAttempted",
            "uniqueFixturesExecuted",
            "uniqueFixturesNotExecuted",
            "uniqueFixturesMeetingAllRequiredExpectations",
            "uniqueFixturesFailingOneOrMoreRequiredExpectations",
            "pdfsProduced",
            "structurallyValidPdfs",
            "correctlyRenderedPdfs",
            "incorrectlyRenderedPdfs",
            "failedPdfGenerations",
            "unsupportedFixtures",
            "intentionallyRejectedFixtures",
            "environmentalLimitationFixtures",
            "auditToolLimitationFixtures",
            "unavailableFixtures",
            "productionRate",
            "structuralValidityRate",
            "correctRenderingRate"
          ],
          "properties": {
            "category": { "type": "string", "minLength": 1 },
            "uniqueFixturesAttempted": { "type": "integer", "minimum": 0 },
            "uniqueFixturesExecuted": { "type": "integer", "minimum": 0 },
            "uniqueFixturesNotExecuted": { "type": "integer", "minimum": 0 },
            "uniqueFixturesMeetingAllRequiredExpectations": { "type": "integer", "minimum": 0 },
            "uniqueFixturesFailingOneOrMoreRequiredExpectations": { "type": "integer", "minimum": 0 },
            "pdfsProduced": { "type": "integer", "minimum": 0 },
            "structurallyValidPdfs": { "type": "integer", "minimum": 0 },
            "correctlyRenderedPdfs": { "type": "integer", "minimum": 0 },
            "incorrectlyRenderedPdfs": { "type": "integer", "minimum": 0 },
            "failedPdfGenerations": { "type": "integer", "minimum": 0 },
            "unsupportedFixtures": { "type": "integer", "minimum": 0 },
            "intentionallyRejectedFixtures": { "type": "integer", "minimum": 0 },
            "environmentalLimitationFixtures": { "type": "integer", "minimum": 0 },
            "auditToolLimitationFixtures": { "type": "integer", "minimum": 0 },
            "unavailableFixtures": { "type": "integer", "minimum": 0 },
            "productionRate": { "$ref": "#/$defs/rate" },
            "structuralValidityRate": { "$ref": "#/$defs/rate" },
            "correctRenderingRate": { "$ref": "#/$defs/rate" }
          }
        }
      },
      "required": ["schemaVersion", "kind", "runId", "completionStatus", "manifest", "executions", "metrics", "releaseAssessment"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "pdf-quality-audit" },
        "runId": { "type": "string", "minLength": 1 },
        "completionStatus": { "enum": ["complete", "complete_with_unavailable_evidence", "incomplete_safety_or_authorization", "not_run_technical_impossibility"] },
        "manifest": { "type": "object" },
        "executions": { "type": "array" },
        "metrics": {
          "type": "object",
          "additionalProperties": true,
          "required": ["totalExecutions", "totalRequestAttempts", "categories", "supportedBasic"],
          "properties": {
            "totalExecutions": { "type": "integer", "minimum": 0 },
            "totalRequestAttempts": { "type": "integer", "minimum": 0 },
            "categories": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/categoryMetrics" }
            },
            "supportedBasic": { "$ref": "#/$defs/categoryMetrics" }
          }
        },
        "releaseAssessment": { "const": "not-performed" }
      }
    }
  }
}
