{
  "name": "pdf-creator",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticated, application-neutral HTML-to-PDF service.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run tests/unit tests/regression",
    "test:full": "npm run typecheck && npm run lint && npm test && npm run test:browser && npm run test:visual",
    "test:mocks": "vitest run tests/unit/r2.test.ts tests/unit/report-store.test.ts tests/unit/idempotency.test.ts tests/unit/renderer-cleanup.test.ts tests/unit/rate-limit.test.ts",
    "test:watch": "vitest",
    "test:browser": "playwright test tests/browser/console.spec.ts",
    "test:visual": "playwright test tests/browser/visual-regression.spec.ts",
    "test:live": "node --env-file-if-exists=.env.local scripts/run-live-reliability.mjs",
    "test:preview": "node --env-file-if-exists=.env.local scripts/run-live-reliability.mjs",
    "test:preview:storage": "node --env-file-if-exists=.env.local scripts/run-preview-storage-workflow.mjs",
    "test:report": "node scripts/generate-test-report.mjs",
    "audit:preflight": "node scripts/run-quality-audit.mjs preflight --profile pr-a-local",
    "audit:self-test": "vitest run tests/quality-audit/harness-self.test.ts",
    "audit:core": "vitest run tests/quality-audit/core.test.ts",
    "audit:preview": "node --env-file-if-exists=.env.local scripts/run-quality-audit.mjs run --profile pr-a-preview",
    "audit:preview:basic-remediation": "node --env-file-if-exists=.env.local scripts/run-quality-audit.mjs run --profile pr-a-preview-basic-remediation",
    "audit:report": "node scripts/run-quality-audit.mjs report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1094.0",
    "@sparticuz/chromium": "149.0.0",
    "@vercel/firewall": "1.2.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "css-tree": "3.2.1",
    "next": "16.2.11",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "puppeteer-core": "25.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/css-tree": "2.3.11",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.33.0",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": "24.x"
  }
}
